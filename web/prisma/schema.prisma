generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Case {
  id            Int          @id @default(autoincrement())
  name          String       @unique @db.VarChar(255)
  slug          String       @unique @db.VarChar(255)
  wikiUrl       String?      @map("wiki_url")
  totalEpisodes Int          @default(3) @map("total_episodes")
  description   String?
  coverImageUrl String?      @map("cover_image_url")
  createdAt     DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  caseBundles   CaseBundle[]
  episodes      Episode[]

  @@map("cases")
}

model Episode {
  id                       Int        @id @default(autoincrement())
  caseId                   Int?       @map("case_id")
  episodeNumber            Int        @map("episode_number")
  episodeTitle             String     @map("episode_title") @db.VarChar(255)
  outline                  Json
  fullScript               String     @map("full_script")
  wordCount                Int?       @map("word_count")
  estimatedDurationMinutes Int?       @map("estimated_duration_minutes")
  filename                 String?    @db.VarChar(255)
  isFinalEpisode           Boolean?   @default(false) @map("is_final_episode")
  priceCents               Int?       @default(499) @map("price_cents")
  createdAt                DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  case                     Case?      @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchases                Purchase[]

  @@unique([caseId, episodeNumber])
  @@index([caseId], map: "idx_episodes_case_id")
  @@index([outline], map: "idx_episodes_outline", type: Gin)
  @@map("episodes")
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique
  passwordHash      String          @map("password_hash")
  name              String?
  stripeCustomerId  String?         @unique @map("stripe_customer_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")
  
  purchases         Purchase[]
  caseBundles       CaseBundle[]
  subscriptions     Subscription[]
  
  @@map("users")
}

model Purchase {
  id                    Int       @id @default(autoincrement())
  userId                Int	  @map("user_id")
  episodeId             Int?      @map("episode_id")
  pricePaidCents        Int       @map("price_paid_cents")
  stripePaymentIntentId String?   @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  purchasedAt           DateTime? @default(now()) @map("purchased_at") @db.Timestamp(6)
  episode               Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, episodeId])
  @@index([episodeId], map: "idx_purchases_episode_id")
  @@index([userId], map: "idx_purchases_user_id")
  @@map("purchases")
}

model CaseBundle {
  id                    Int       @id @default(autoincrement())
  caseId                Int?      @map("case_id")
  userId                Int       @map("user_id")
  pricePaidCents        Int       @map("price_paid_cents")
  stripePaymentIntentId String?   @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  purchasedAt           DateTime? @default(now()) @map("purchased_at") @db.Timestamp(6)
  case                  Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, caseId])
  @@index([userId], map: "idx_case_bundles_user_id")
  @@map("case_bundles")
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id") @db.VarChar(255)
  status               String    @db.VarChar(50)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamp(6)
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_subscriptions_user_id")
  @@map("subscriptions")
}

    {
      "parameters": {
        "jsCode": "// Il dato arriva nel body del webhook\nconst caseName = $input.item.json.body.case_name;\n\n// Trasforma il nome in formato URL Wikipedia\nconst wikiUrl = `https://en.wikipedia.org/wiki/${caseName.replace(/ /g, '_')}`;\n\nreturn {\n  json: {\n    case_name: caseName,\n    wiki_url: wikiUrl\n  }\n};"
      },

    {
      "parameters": {
        "jsCode": "const html = $input.item.json.data;\n\n// Rimuove tag HTML basilari (regex semplice per MVP)\nconst text = html\n  .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n  .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// Prendi primi 3000 caratteri\nconst summary = text.substring(0, 3000);\n\nreturn {\n  json: {\n    case_name: $input.item.json.case_name,\n    wiki_url: $input.item.json.wiki_url,\n    raw_text: summary\n  }\n};"
      },
